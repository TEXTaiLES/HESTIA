{
	"name": "directus-interface-generate-thumbnail",
	"description": "Directus interface button to generate artefact thumbnail",
	"icon": "extension",
	"version": "1.0.0",
	"private": true,
	"keywords": [
		"directus",
		"directus-extension",
		"directus-extension-interface"
	],
	"files": [
		"dist"
	],
	"directus:extension": {
		"type": "interface",
		"path": "dist/index.js",
		"source": "src/index.js",
		"host": "^9.22.0",
		"id": "generate-thumbnail"
	},
	"scripts": {
		"build": "directus-extension build",
		"dev": "directus-extension build -w --no-minify",
		"link": "directus-extension link",
		"validate": "directus-extension validate"
	},
	"devDependencies": {
		"@directus/extensions-sdk": "9.22.0"
	},
	"dependencies": {}
}
