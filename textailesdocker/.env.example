# Copy this file and name the copy ".env".
# Do NOT commit the .env file to git!

# --- API Security ---
API_SECRET_KEY="change-me-locally"

# --- Public Access (For generating URLs) ---
PUBLIC_MINIO_ENDPOINT="localhost:9001"
PUBLIC_MINIO_SCHEME="http"

# --- MinIO Credentials ---
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="minioadmin"

# --- Postgres Credentials ---
POSTGRES_USER="admin"
POSTGRES_PASSWORD="admin123"
POSTGRES_DB="mydb"

# --- Directus Credentials ---
DIRECTUS_KEY="your_directus_key"
DIRECTUS_SECRET="your_directus_secret"
DIRECTUS_ADMIN_EMAIL="admin@example.com"
DIRECTUS_ADMIN_PASSWORD="admin123"

# Cookie domain for all subdomains
COOKIE_DOMAIN=".textailes.athenarc.gr"
HOST_DOMAIN="textailes.athenarc.gr"

# --- Directus Configuration ---
CORS_ENABLED=true
CORS_ORIGIN=*
CORS_METHODS=GET,POST,PATCH,DELETE
CORS_ALLOWED_HEADERS=*
CORS_EXPOSED_HEADERS=*
