# Copy this file and name the copy ".env".
# Do NOT commit the .env file to git!

# --- API Security ---
API_SECRET_KEY="change-me-locally"

# --- Public Access (For generating URLs) ---
PUBLIC_MINIO_ENDPOINT="localhost:9001"
PUBLIC_MINIO_SCHEME="http"

# --- MinIO Credentials ---
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="minioadmin"

# --- Postgres Credentials ---
POSTGRES_USER="admin"
POSTGRES_PASSWORD="admin123"
POSTGRES_DB="mydb"

# --- Directus Credentials ---
DIRECTUS_KEY="your_directus_key"
DIRECTUS_SECRET="your_directus_secret"
DIRECTUS_ADMIN_EMAIL="admin@example.com"
DIRECTUS_ADMIN_PASSWORD="admin123"

# --- Archive Authentication ---
# Editor Role ID from directus_roles table (Query: SELECT id FROM directus_roles WHERE name = 'Editor Role')
ARCHIVE_EDITOR_ROLE_ID="6a0c9fac-5edd-408c-813e-cfd5e2ea4ed7"

# Member Role ID from directus_roles table (Query: SELECT id FROM directus_roles WHERE name = 'Member Role')
ARCHIVE_MEMBER_ROLE_ID="1ae67ebc-2efc-46dd-b02a-bf0ae582c921"

# --- Directus Configuration ---
CORS_ENABLED=true
CORS_ORIGIN=*
CORS_METHODS=GET,POST,PATCH,DELETE
CORS_ALLOWED_HEADERS=*
CORS_EXPOSED_HEADERS=*

# --- Directus SMTP ---
EMAIL_TRANSPORT="smtp"
EMAIL_SMTP_HOST="smtp.example.com"
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER="admin@example.com"
EMAIL_SMTP_PASSWORD="admin123"
EMAIL_SMTP_SECURE=1
EMAIL_SMTP_IGNORE_TLS=0

# --- Cookie domain ---
# Setting it will enable it for all subdomains
COOKIE_DOMAIN=".textailes.athenarc.gr"
