{
    "name": "robot-sink",
    "config": {
        "connector.class": "io.confluent.connect.jdbc.JdbcSinkConnector",
        "tasks.max": "1",
        "topics": "robot_images",
        "connection.url": "jdbc:postgresql://postgres:5432/db",
        "connection.user": "pg_user",
        "connection.password": "pg_password",
        "auto.create": "true",
        "auto.evolve": "true",
        "insert.mode": "upsert",
        "pk.mode": "record_value",
        "pk.fields": "image_id",
        "table.name.format": "robot_images"
    }
}